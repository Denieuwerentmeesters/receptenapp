{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/extraheer.ts": {
      "maxDuration": 60
    },
    "api/afbeeldingen.ts": {
      "maxDuration": 300
    },
    "api/vertalen.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/afbeeldingen",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/vertalen",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/vertalen?ronde=2",
      "schedule": "6 4 * * *"
    },
    {
      "path": "/api/vertalen?ronde=3",
      "schedule": "12 4 * * *"
    },
    {
      "path": "/api/vertalen?ronde=4",
      "schedule": "18 4 * * *"
    },
    {
      "path": "/api/vertalen?ronde=5",
      "schedule": "24 4 * * *"
    }
  ],
  "installCommand": "npm install && cd app && npm install",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "redirects": [
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=nl.reinoudtencate.receptenapp",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:pad*",
      "destination": "/api/auth?pad=:pad*"
    },
    {
      "source": "/r/:id",
      "destination": "/api/recept?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
