{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/extraheer.ts": { "maxDuration": 60 }
  },
  "installCommand": "cd app && npm install",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
