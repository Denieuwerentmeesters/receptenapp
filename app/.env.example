# Kopieer naar .env.local en vul in.
# Beide waarden staan in Neon → je project → Connect to your branch.

# Tabblad "Data API" — eindigt op /rest/v1
VITE_NEON_DATA_API_URL=

# Tabblad "Auth" — de Auth URL (niet de JWKS URL)
VITE_NEON_AUTH_URL=

# De serverless functie die kookboekfoto's uitleest (api/extraheer.ts op Vercel).
# Laat leeg voor de standaard: /api/extraheer op hetzelfde domein. Vul alleen in
# om lokaal tegen een andere omgeving te testen.
VITE_EXTRACTIE_URL=
